@server = http://localhost:3000
@expenses = {{server}}/api/expenses

### Get all expenses
GET {{expenses}}

### Add a new expense
POST {{expenses}}
Content-Type: application/json

{
  "date": "2025-10-15",
  "description": "Team lunch",
  "payer": "John",
  "amount": 45.50
}

### Reset expenses
POST {{expenses}}/reset


###
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "bob@example.com",
  "password": "topsecret"
}